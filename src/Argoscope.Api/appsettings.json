{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Argoscope": ""
  },
  "GitHub": {
    "BaseUrl": "https://api.github.com",
    "UserAgent": "argoscope/0.1",
    "GraphQlAccept": "application/vnd.github+json",
    "MaxPagesPerRun": 100,
    "MaxRetryAfterSeconds": 600,
    "Token": ""
  },
  "Argoscope": {
    "Collection": {
      "IntervalHours": 24,
      "StartHourUtc": 3,
      "RunOnStartup": false
    }
  }
}
